{
  "name": "seed-project-devops",
  "version": "1.0.0",
  "private": true,
  "description": "Seed project for DevOps course - Order Processing Engine with Frontend & Multi-Process Backend",
  "type": "module",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:worker": "npm run dev:worker --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:coverage": "npm run test:coverage --prefix backend",
    "prepare": "husky"
  },
  "keywords": [
    "devops",
    "seed-project",
    "order-processing",
    "microservices",
    "nodejs",
    "prometheus",
    "redis",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7"
  }
}
